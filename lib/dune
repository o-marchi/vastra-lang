(library
 (name vastra)
 (public_name vastra)
 (libraries zarith unix mtime.clock))

(rule
 (target prelude_source.ml)
 (deps prelude.vas)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {vastra|")
    (cat prelude.vas)
    (echo "|vastra}\n")))))

(rule
 (target why_source.ml)
 (deps why.txt)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {why|")
    (cat why.txt)
    (echo "|why}\n")))))

(rule
 (target stdlib_sources.ml)
 (deps
  (glob_files stdlib/*.vas))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed/embed.exe} %{deps}))))
