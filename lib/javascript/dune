; vastra.javascript, apart from the vastra library: vastra.js links that one,
; and must not carry the printer.

(library
 (name vastra_javascript)
 (public_name vastra.javascript)
 (libraries vastra str))

(rule
 (target runtime_source.ml)
 (deps runtime.js)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {runtime|")
    (cat runtime.js)
    (echo "|runtime}\n")))))
