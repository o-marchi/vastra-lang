(executable
 (name main)
 (public_name vastra)
 (package vastra)
 (libraries vastra vastra.window terminal unix threads.posix tiny_httpd))

; vastra serve gives pages the vastra.js this command was built with.

(rule
 (target vastra_js.ml)
 (deps ../web/vastra.js)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {vastra_js|")
    (cat ../web/vastra.js)
    (echo "|vastra_js}\n")))))
