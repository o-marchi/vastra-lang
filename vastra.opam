opam-version: "2.0"
synopsis: "An interactive, safe and fast Lisp"
license: "MIT"
depends: [
  "ocaml"
  "dune" {>= "3.0"}
  "zarith"
  "tiny_httpd"
  "js_of_ocaml"
  "js_of_ocaml-ppx"
  "zarith_stubs_js"
  "tsdl"
  "mtime"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
